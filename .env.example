# LightPanel System Configuration
PORT=3001
NODE_ENV=production

# Security & Secrets
JWT_SECRET=change_this_to_a_random_secure_secret_key_32_chars
COOKIE_SECRET=change_this_cookie_secret_key

# PostgreSQL Database Connection
DATABASE_URL=postgres://postgres:postgres_secure_pass@localhost:5432/lightpanel

# Redis Cache & Queue Connection
REDIS_URL=redis://localhost:6379

# Server Identity & Domains
HOSTNAME=vps-prod-01
PRIMARY_DOMAIN=lightpanel.dev
ADMIN_EMAIL=admin@lightpanel.dev

# Default Quotas (-1 = Unlimited)
DEFAULT_USER_STORAGE_MB=-1
DEFAULT_MAILBOX_QUOTA_MB=-1
DEFAULT_RATE_LIMIT_PER_HOUR=-1

# Analytics Engine (true / false)
ANALYTICS_ENABLED=true
